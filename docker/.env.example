# Use URL-safe values (letters, numbers, underscores, and hyphens) for MongoDB credentials.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=gcc-api
MONGO_VOLUME_NAME=gcc-api-server-mongo-data
MONGO_BACKUP_DIRECTORY=../backups
MONGO_BACKUP_INTERVAL_SECONDS=86400
MONGO_BACKUP_RETENTION_DAYS=30

AUTH_NAME=
AUTH_PASSWORD=

API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_PORT=27017
